                        <td>Monetización Interna</td>
                        <td>Sin microtransacciones</td>
                        <td>Monedas virtuales y cosméticos</td>
                    </tr>
                    <tr>
                        <td>Enfoque Principal</td>
                        <td>Diseño artístico y jugabilidad</td>
                        <td>Retorno de inversión y pase de batalla</td>
                    </tr>
                    <tr>
                        <td>Filosofía de Comunidad</td>
                        <td>Fidelización a largo plazo</td>
                        <td>Maximización del gasto del usuario</td>
                    </tr>
                </tbody>
            </table>
        </section>

